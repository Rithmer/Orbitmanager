# PostgreSQL
DB_NAME=task_manager
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5433

# E2E PostgreSQL
E2E_DB_NAME=task_manager_e2e
E2E_DB_USERNAME=postgres
E2E_DB_PASSWORD=postgres
E2E_DB_PORT=5434

# App
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
THROTTLE_TTL=60000
THROTTLE_LIMIT=180
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=20
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=5000
LOG_LEVEL=info
AUTO_SEED=true

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ML Risk Service
RISK_PROVIDER=stub            # stub | ml
ML_SERVICE_URL=http://ml-service:8000
