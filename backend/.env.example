NODE_ENV=development
PORT=3000

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/task_manager

# Host-side connection to the Docker PostgreSQL container.
DB_NAME=task_manager
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5433

DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=5000

CORS_ORIGIN=http://localhost:5173,http://localhost:3000
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
LOG_LEVEL=info
