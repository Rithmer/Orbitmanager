NODE_ENV=development          # development | production | test
PORT=3000                     # HTTP-порт NestJS сервера

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars    # Минимум 32 случайных символа (openssl rand -hex 32)
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars  # Минимум 32 случайных символа (openssl rand -hex 32)
JWT_ACCESS_EXPIRES_IN=15m     # TTL access-токена (формат: 15m, 1h)
JWT_REFRESH_EXPIRES_IN=7d     # TTL refresh-токена (формат: 7d, 30d)

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/task_manager

# Host-side connection to the Docker PostgreSQL container.
DB_NAME=task_manager
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5433

DB_POOL_MIN=2                 # Минимальный размер пула соединений Prisma
DB_POOL_MAX=10                # Максимальный размер пула соединений
DB_POOL_IDLE_TIMEOUT=30000    # Таймаут простоя соединения (мс)
DB_POOL_CONNECTION_TIMEOUT=5000 # Таймаут установки соединения (мс)

CORS_ORIGIN=http://localhost:5173,http://localhost:3000 # Разрешённый origin для CORS (фронтенд URL)
THROTTLE_TTL=60000            # Окно троттлинга в мс (глобальный лимит)
THROTTLE_LIMIT=180            # Максимум запросов в THROTTLE_TTL окне
THROTTLE_AUTH_TTL=60000       # Окно троттлинга для /auth эндпоинтов (мс)
THROTTLE_AUTH_LIMIT=20        # Максимум запросов для /auth в THROTTLE_AUTH_TTL
LOG_LEVEL=info                # debug | info | warn | error
