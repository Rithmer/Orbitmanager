generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  login         String   @unique @db.VarChar(50)
  password      String
  fullName      String   @map("full_name")
  profession    String   @default("")
  accountStatus String   @default("active") @map("account_status")
  accountRole   String   @default("member") @map("account_role")
  avatarUrl     String?  @map("avatar_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  teams          Team[]
  teamMembers    TeamMember[]
  projectMembers ProjectMember[]
  createdTasks   Task[]          @relation("TaskCreator")
  taskAssignees  TaskAssignee[]
  auditLogs      AuditLog[]
  calendarEvents CalendarEvent[]

  @@map("users")
}

model Team {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  createdById Int      @map("created_by_id")

  createdBy   User         @relation(fields: [createdById], references: [id])
  members     TeamMember[]
  projects    Project[]

  @@index([createdById])
  @@map("teams")
}

model TeamMember {
  id       Int    @id @default(autoincrement())
  userId   Int    @map("user_id")
  teamId   Int    @map("team_id")
  teamRole String @map("team_role")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
  @@map("team_members")
}

model Project {
  id          Int      @id @default(autoincrement())
  teamId      Int      @map("team_id")
  name        String
  description String   @default("")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  team           Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  members        ProjectMember[]
  tasks          Task[]
  calendarEvents CalendarEvent[]

  @@index([teamId])
  @@map("projects")
}

model ProjectMember {
  id         Int      @id @default(autoincrement())
  projectId  Int      @map("project_id")
  userId     Int      @map("user_id")
  role       String
  assignedAt DateTime @default(now()) @map("assigned_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  name        String
  description String   @default("")
  deadline    DateTime
  status      String   @default("new")
  difficulty  Int
  createdById Int      @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User            @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignees      TaskAssignee[]
  calendarEvents CalendarEvent[]

  @@index([projectId])
  @@map("tasks")
}

model TaskAssignee {
  id     Int @id @default(autoincrement())
  taskId Int @map("task_id")
  userId Int @map("user_id")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    Int?     @map("entity_id")
  oldValue    String?  @map("old_value")
  newValue    String?  @map("new_value")
  timestamp   DateTime @default(now())
  description String   @default("")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([timestamp])
  @@map("audit_logs")
}

model CalendarEvent {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  projectId   Int?     @map("project_id")
  taskId      Int?     @map("task_id")
  title       String   @db.VarChar(200)
  description String   @default("")
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  allDay      Boolean  @default(false) @map("all_day")
  color       String   @default("#3b82f6") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, startDate])
  @@map("calendar_events")
}
