NODE_ENV=test
PORT=3000

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/task_manager_e2e

# Host-side connection to the dedicated Docker PostgreSQL container for e2e tests.
DB_NAME=task_manager_e2e
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5434

CORS_ORIGIN=http://localhost:5173,http://localhost:3000
THROTTLE_TTL=60000
THROTTLE_LIMIT=180
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=20
LOG_LEVEL=info
