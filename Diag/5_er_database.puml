@startuml
' ============================================================
' Диаграмма 5. ER-диаграмма базы данных
' Нотация «воронья лапка» (Information Engineering / Crow's Foot)
' 10 сущностей, PK, FK, UNIQUE, NOT NULL, справочники
' ============================================================

title ER-диаграмма базы данных\nНотация «воронья лапка» (Crow's Foot)\n10 сущностей

skinparam linetype ortho

hide circle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

' ============================================================
' СПРАВОЧНИКИ
' ============================================================

entity "account_roles" as ar #F5F5F5 {
  * **id** : int <<PK, auto-increment>>
  --
  * name : varchar <<UNIQUE, NOT NULL>>
  ..
  //Значения: admin | member | guest//
}

entity "team_roles" as tr #F5F5F5 {
  * **id** : int <<PK, auto-increment>>
  --
  * name : varchar <<UNIQUE, NOT NULL>>
  ..
  //Значения: owner | team_lead//
  //| developer | observer//
}

' ============================================================
' ПОЛЬЗОВАТЕЛИ
' ============================================================

entity "users" as u {
  * **id** : int <<PK, auto-increment>>
  --
  * login : varchar <<UNIQUE, NOT NULL, 3..50>>
  * password : varchar <<NOT NULL, argon2 hash>>
  * fullName : varchar <<NOT NULL>>
    profession : varchar <<nullable>>
  * accountStatus : varchar <<NOT NULL, default 'active'>>
  * accountRoleId : int <<FK → account_roles.id>>
  * createdAt : datetime <<NOT NULL, auto>>
  * updatedAt : datetime <<NOT NULL, auto>>
}

' ============================================================
' КОМАНДЫ
' ============================================================

entity "teams" as t {
  * **id** : int <<PK, auto-increment>>
  --
  * name : varchar <<NOT NULL>>
    description : text <<nullable>>
  * createdAt : datetime <<NOT NULL, auto>>
  * createdById : int <<FK → users.id, NOT NULL>>
}

' ============================================================
' УЧАСТНИКИ КОМАНДЫ
' ============================================================

entity "team_members" as tm {
  * **id** : int <<PK, auto-increment>>
  --
  * userId : int <<FK → users.id, NOT NULL>>
  * teamId : int <<FK → teams.id, NOT NULL>>
  * teamRoleId : int <<FK → team_roles.id, NOT NULL>>
    projectId : int <<FK → projects.id, nullable>>
  ..
  //UNIQUE(userId, teamId, projectId)//
  //owner/developer: projectId = null//
  //team_lead/observer: projectId = конкретный проект//
}

' ============================================================
' ПРОЕКТЫ
' ============================================================

entity "projects" as p {
  * **id** : int <<PK, auto-increment>>
  --
  * teamId : int <<FK → teams.id, NOT NULL>>
  * name : varchar <<NOT NULL>>
    description : text <<nullable>>
  * status : varchar <<NOT NULL, default 'active'>>
  * createdAt : datetime <<NOT NULL, auto>>
  * updatedAt : datetime <<NOT NULL, auto>>
  ..
  //status: active | on_hold//
  //| completed | archived//
}

' ============================================================
' ЗАДАЧИ
' ============================================================

entity "tasks" as tk {
  * **id** : int <<PK, auto-increment>>
  --
  * projectId : int <<FK → projects.id, NOT NULL>>
  * name : varchar <<NOT NULL>>
    description : text <<nullable>>
  * deadline : datetime <<NOT NULL>>
  * status : varchar <<NOT NULL, default 'new'>>
  * difficulty : int <<NOT NULL, CHECK 1..5>>
  * createdById : int <<FK → users.id, NOT NULL>>
  * createdAt : datetime <<NOT NULL, auto>>
  * updatedAt : datetime <<NOT NULL, auto>>
  ..
  //status: new | in_progress//
  //| review | done | cancelled//
  //Ограничение: deadline ≥ createdAt//
}

' ============================================================
' НАЗНАЧЕНИЯ ЗАДАЧ
' ============================================================

entity "task_assignments" as ta {
  * **id** : int <<PK, auto-increment>>
  --
  * taskId : int <<FK → tasks.id, NOT NULL>>
  * userId : int <<FK → users.id, NOT NULL>>
  * assignedAt : datetime <<NOT NULL, auto>>
  * status : varchar <<NOT NULL, default 'assigned'>>
  ..
  //status: assigned | in_progress//
  //| completed | rejected//
}

' ============================================================
' ИСТОРИЯ ЗАДАЧ
' ============================================================

entity "task_history" as th {
  * **id** : int <<PK, auto-increment>>
  --
  * taskId : int <<FK → tasks.id, NOT NULL>>
  * userId : int <<FK → users.id, NOT NULL>>
  * oldStatus : varchar <<NOT NULL>>
  * newStatus : varchar <<NOT NULL>>
  * changedAt : datetime <<NOT NULL, auto>>
    comment : text <<nullable>>
  ..
  //Автосоздание при смене статуса//
}

' ============================================================
' ЖУРНАЛ ДЕЙСТВИЙ
' ============================================================

entity "audit_logs" as al {
  * **id** : int <<PK, auto-increment>>
  --
  * userId : int <<FK → users.id, NOT NULL>>
  * action : varchar <<NOT NULL>>
  * entityType : varchar <<NOT NULL>>
    entityId : int <<nullable>>
  * timestamp : datetime <<NOT NULL, auto>>
    description : text <<nullable>>
  ..
  //action: create | update | delete//
  //| login | logout | assign//
  //| status_change//
}

' ============================================================
' СВЯЗИ (воронья лапка)
' ============================================================

' Справочники → Основные таблицы
ar ||--o{ u : "accountRoleId"
tr ||--o{ tm : "teamRoleId"

' Пользователи → Связи
u ||--o{ t : "createdById\n(создатель команды)"
u ||--o{ tm : "userId\n(участник)"
u ||--o{ tk : "createdById\n(постановщик)"
u ||--o{ ta : "userId\n(исполнитель)"
u ||--o{ th : "userId\n(автор изменения)"
u ||--o{ al : "userId\n(инициатор)"

' Команды → Участники, Проекты
t ||--o{ tm : "teamId"
t ||--o{ p : "teamId"

' Проекты → Задачи, Участники (scope)
p ||--o{ tk : "projectId"
p ||--o{ tm : "projectId\n(scope, nullable)"

' Задачи → Назначения, История
tk ||--o{ ta : "taskId"
tk ||--o{ th : "taskId"

@enduml
