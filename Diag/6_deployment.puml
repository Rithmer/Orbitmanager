@startuml deployment_diagram
' ============================================================
' Диаграмма 6. Развертывание
' Текущий Docker Compose runtime
' ============================================================

title Диаграмма 6. Развертывание\nDocker Compose: frontend -> backend -> postgres

skinparam shadowing false
skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #4A5568
}
skinparam component {
  BackgroundColor #E8F5E9
  BorderColor #4A5568
}
skinparam database {
  BackgroundColor #E3F2FD
  BorderColor #4A5568
}
skinparam artifact {
  BackgroundColor #FFF8E1
  BorderColor #4A5568
}
skinparam folder {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
}

legend right
|= Маркер |= Значение |
|<#FFFFFF>|Реализованный runtime|
|<#F3F4F6>|Planned: будущий ML-контур|
endlegend

node "Устройство пользователя" as client {
  component "Браузер" as browser
}

cloud "Docker Network\napp-network" as network

node "Контейнер frontend\nDocker + nginx" <<Docker>> as frontend #F3F4F6 {
  component "nginx\ncontainer port 80" as nginx
  artifact "React/Vite scaffold\nстатическая сборка" as spa
}

note right of frontend
  Host port: 5173 -> 80
  nginx отдает index.html и assets
  и проксирует /api и /auth в backend
  Предметный UI пока не реализован
end note

node "Контейнер backend\nDocker + NestJS" <<Docker>> as backend {
  component "REST API\ncontainer port 3000" as api
  component "Swagger UI\n/api/docs" as swagger
  component "Prisma ORM" as prisma
  component "Winston + LoggingInterceptor" as logging
  artifact "docker-entrypoint.sh" as entrypoint
  folder "bind mounts\nlogs/ и backups/" as mounts
}

note right of backend
  Host port: 3000 -> 3000
  Healthcheck: GET /
  Modules: auth, users, teams,
  projects, tasks, audit-logs, risk
end note

node "Контейнер postgres\nPostgreSQL 16-alpine" <<Docker>> as postgres {
  database "task_manager" as db
}

note right of postgres
  Internal port: 5432
  Host port: ${DB_PORT:-5433} -> 5432
  Prisma migrations и seed
end note

node "Planned ML-контур" <<planned>> as ml #F3F4F6 {
  component "RiskMlService\nmodel runtime / retraining" as mlruntime
  artifact "models/risk-model.*" as mlmodel
}

note right of ml
  Вне текущего runtime-path.
  Сейчас backend использует RiskStubService.
end note

browser --> nginx : HTTP :5173
nginx --> spa : static files
nginx --> api : /api и /auth\nHTTP :3000

api --> swagger : /api/docs
api --> prisma
api --> logging
api --> entrypoint
api --> mounts
prisma --> db : TCP 5432

frontend -[hidden]- network
backend -[hidden]- network
postgres -[hidden]- network
ml -[hidden]- network

api ..> mlruntime : planned DI switch
mlruntime --> mlmodel

@enduml
