@startuml
' ============================================================
' Диаграмма 4б. Архитектурные классы и паттерны
' ============================================================

title Диаграмма классов 4б\nNestJS архитектура: controllers, services, repositories, Prisma

skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #4A5568
  ArrowColor #4A5568
}
skinparam interface {
  BorderColor #4A5568
}

package "Клиенты" #F3F4F6 {
  class SwaggerUI <<client>> {
    /api/docs
  }

  class ReactSPA <<planned>> {
    planned frontend scaffold
  }
}

package "REST API boundary" #E8F5E9 {
  class RestApi <<boundary>> {
    NestJS HTTP API
  }

  class AuthController <<controller>>
  class UsersController <<controller>>
  class TeamsController <<controller>>
  class TeamMembersController <<controller>>
  class ProjectsController <<controller>>
  class ProjectMembersController <<controller>>
  class TasksController <<controller>>
  class AuditLogsController <<controller>>
  class RiskController <<controller>>
}

package "Application Services" #FFF8E1 {
  class AuthService <<service>>
  class UsersService <<service>>
  class TeamsService <<service>>
  class ProjectsService <<service>>
  class TasksService <<service>>
  class AuditService <<service>>
}

package "Risk Strategy" #FFF3E0 {
  interface IRiskAssessmentService
  class RiskStubService <<stub>>
  class RiskMlService <<planned>>
}

package "Repository Interfaces" #E3F2FD {
  interface IUserRepository
  interface ITeamRepository
  interface ITeamMemberRepository
  interface IProjectRepository
  interface IProjectMemberRepository
  interface ITaskRepository
  interface IAuditLogRepository
}

package "Prisma Repositories" #E8F5E9 {
  class UsersPrismaRepository
  class TeamsPrismaRepository
  class TeamMembersPrismaRepository
  class ProjectsPrismaRepository
  class ProjectMembersPrismaRepository
  class TasksPrismaRepository
  class AuditLogsPrismaRepository
  class PrismaService <<infrastructure>>
}

package "Guards и декораторы" #FCE4EC {
  class JwtAuthGuard <<guard>>
  class AccountRolesGuard <<guard>>
  class TeamRolesGuard <<guard>>
  class ProjectRolesGuard <<guard>>
  class Roles <<decorator>>
  class TeamRoles <<decorator>>
  class ProjectRoles <<decorator>>
  class CurrentUser <<decorator>>
}

SwaggerUI --> RestApi
ReactSPA ..> RestApi : planned\nтот же REST API

RestApi --> AuthController
RestApi --> UsersController
RestApi --> TeamsController
RestApi --> TeamMembersController
RestApi --> ProjectsController
RestApi --> ProjectMembersController
RestApi --> TasksController
RestApi --> AuditLogsController
RestApi --> RiskController

AuthController --> AuthService
UsersController --> UsersService
TeamsController --> TeamsService
TeamMembersController --> TeamsService
ProjectsController --> ProjectsService
ProjectMembersController --> ProjectsService
TasksController --> TasksService
AuditLogsController --> AuditService
RiskController --> IRiskAssessmentService

AuthService --> UsersService
AuthService --> AuditService
UsersService --> IUserRepository
UsersService --> ITeamRepository
UsersService --> ITaskRepository
UsersService --> IAuditLogRepository
UsersService --> AuditService

TeamsService --> ITeamRepository
TeamsService --> ITeamMemberRepository
TeamsService --> IUserRepository
TeamsService --> IProjectRepository
TeamsService --> IProjectMemberRepository
TeamsService --> ITaskRepository
TeamsService --> AuditService

ProjectsService --> IProjectRepository
ProjectsService --> IProjectMemberRepository
ProjectsService --> ITeamMemberRepository
ProjectsService --> ITaskRepository
ProjectsService --> ITeamRepository
ProjectsService --> AuditService

TasksService --> ITaskRepository
TasksService --> IProjectRepository
TasksService --> IProjectMemberRepository
TasksService --> ITeamMemberRepository
TasksService --> AuditService

AuditService --> IAuditLogRepository
RiskController --> ITaskRepository
RiskController --> IProjectRepository
RiskController --> IProjectMemberRepository
RiskController --> ITeamMemberRepository
RiskController --> IAuditLogRepository

IRiskAssessmentService <|.. RiskStubService
IRiskAssessmentService <|.. RiskMlService

IUserRepository <|.. UsersPrismaRepository
ITeamRepository <|.. TeamsPrismaRepository
ITeamMemberRepository <|.. TeamMembersPrismaRepository
IProjectRepository <|.. ProjectsPrismaRepository
IProjectMemberRepository <|.. ProjectMembersPrismaRepository
ITaskRepository <|.. TasksPrismaRepository
IAuditLogRepository <|.. AuditLogsPrismaRepository

UsersPrismaRepository --> PrismaService
TeamsPrismaRepository --> PrismaService
TeamMembersPrismaRepository --> PrismaService
ProjectsPrismaRepository --> PrismaService
ProjectMembersPrismaRepository --> PrismaService
TasksPrismaRepository --> PrismaService
AuditLogsPrismaRepository --> PrismaService

UsersController ..> JwtAuthGuard
TasksController ..> JwtAuthGuard
ProjectsController ..> JwtAuthGuard
TeamsController ..> JwtAuthGuard
AuditLogsController ..> AccountRolesGuard
RiskController ..> AccountRolesGuard
TeamsController ..> TeamRolesGuard
TeamMembersController ..> TeamRolesGuard
ProjectsController ..> ProjectRolesGuard

UsersController ..> Roles
AuditLogsController ..> Roles
RiskController ..> Roles
TeamsController ..> TeamRoles
TeamMembersController ..> TeamRoles
ProjectsController ..> ProjectRoles
TasksController ..> CurrentUser
ProjectsController ..> CurrentUser
TeamsController ..> CurrentUser
RiskController ..> CurrentUser

note bottom of RestApi
  Глобально на уровне приложения:
  ValidationPipe, ThrottlerGuard,
  LoggingInterceptor, Swagger, Winston
end note

note right of RiskStubService
  Текущая реализация через DI:
  rule-based risk assessment
end note

note right of RiskMlService
  Planned:
  полноценная ML-модель
  без изменения API-контракта
end note

@enduml
