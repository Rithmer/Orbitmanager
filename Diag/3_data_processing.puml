@startuml
' ============================================================
' Диаграмма 3. Процесс обработки данных
' БП1: Создание задачи
' ============================================================

title Диаграмма 3. Процесс обработки данных\nБП1: Создание задачи

skinparam shadowing false
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #4A5568
  DiamondBackgroundColor #FFF8E1
}
skinparam note {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
}

start

partition "Клиент: Swagger / planned frontend" #F3F4F6 {
  :Заполнить форму создания задачи;
  note right
    DTO-поля:
    projectId
    name
    description?
    deadline
    difficulty
    assigneeId?
  end note

  :Отправить POST /tasks;
}

partition "Controller Layer" #E8F5E9 {
  :JwtAuthGuard проверяет access token;
  if (JWT валиден?) then (нет)
    :401 Unauthorized;
    stop
  endif

  :ValidationPipe проверяет CreateTaskDto;
  if (DTO валиден?) then (нет)
    :400 Bad Request;
    stop
  endif

  :TasksController.create()\nпередает dto, userId, accountRole;
}

partition "TasksService" #FFF8E1 {
  :IProjectRepository.findById(projectId);
  if (Проект найден?) then (нет)
    :404 Not Found;
    stop
  endif

  if (accountRole = admin?) then (да)
    :Пропустить проверку роли в команде;
  else (нет)
    :Проверить права:\nowner команды\nили team_lead проекта;
    if (Доступ разрешен?) then (нет)
      :403 Forbidden;
      stop
    endif
  endif

  :Проверить, что deadline > now();
  if (Дедлайн корректен?) then (нет)
    :400 Bad Request;
    stop
  endif

  if (assigneeId указан?) then (да)
    :Проверить membership\nчерез IProjectMemberRepository;
    if (Исполнитель состоит в проекте?) then (нет)
      :400 Bad Request;
      stop
    endif
  endif
}

partition "Repository Layer" #E3F2FD {
  :ITaskRepository.create(...);
}

partition "Prisma + PostgreSQL" #E8F5E9 {
  :SELECT project, team membership,\nproject membership;
  :INSERT INTO tasks\n(status='new', created_by_id=userId,\n assignee_id nullable);
  :INSERT INTO audit_logs\n(action='create', entity_type='task');
}

partition "Ответ" #FCE4EC {
  :Сформировать HTTP-ответ Task;
}

partition "Клиент: Swagger / planned frontend" #F3F4F6 {
  :201 Created + Task;
}

stop

@enduml
