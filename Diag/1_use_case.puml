@startuml
' ============================================================
' Диаграмма 1. Варианты использования
' Сервис управления проектами и задачами
' ============================================================

title Диаграмма 1. Варианты использования\nTask Management API

left to right direction
skinparam shadowing false
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #374151
}
skinparam usecase<<stub>> {
  BackgroundColor #FFF3E0
  BorderColor #D97706
}
skinparam usecase<<planned>> {
  BackgroundColor #F5F5F5
  BorderColor #9CA3AF
}

legend right
|= Маркер |= Смысл |
|<#E8F5E9> реализовано | Текущая backend-функциональность |
|<#FFF3E0> stub | Endpoint или provider есть, но логика ограничена |
|<#F5F5F5> planned | Будущее видение, еще не реализовано |
endlegend

actor "Гость" as Guest
actor "Пользователь\n(member)" as User
actor "Администратор\n(admin)" as Admin

Admin -|> User

rectangle "Сервис управления проектами и задачами" #E8F5E9 {
  usecase "UC1: Регистрация\nPOST /auth/register" as UC1
  usecase "UC2: Вход и refresh\nPOST /auth/login\nPOST /auth/refresh" as UC2

  usecase "UC3: Команды\nCRUD /teams" as UC3
  usecase "UC4: Участники команды\n/teams/:teamId/members" as UC4

  usecase "UC5: Проекты\nCRUD /projects" as UC5
  usecase "UC6: Участники проекта\n/projects/:projectId/members" as UC6

  usecase "UC7: Просмотр проектов\nи задач" as UC7
  usecase "UC8: Создание и правка\nзадачи (БП1)" as UC8
  usecase "UC9: Смена статуса задачи\nPATCH /tasks/:id (БП2)" as UC9

  usecase "UC10: Оценка риска задачи\nи проекта" as UC10 <<stub>>
  usecase "UC11: Журнал аудита\nGET /audit-logs" as UC11
  usecase "UC12: Управление\nпользователями" as UC12

  usecase "UC13: Дашборд проекта /\nFrontend UI" as UC13 <<planned>>
  usecase "UC14: Переобучение ML-\nпровайдера риска" as UC14 <<stub>>
}

Guest --> UC1
Guest --> UC2

User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7
User --> UC8
User --> UC9
User --> UC10
User --> UC13

Admin --> UC11
Admin --> UC12
Admin --> UC14

UC13 ..> UC10 : <<include>>

note right of UC10
  Текущая реализация:
  RiskStubService по GET endpoint-ам
  (/tasks/:id/risk, /projects/:id/risk).
  Полноценная ML-модель остается planned.
end note

note bottom of UC9
  PATCH /tasks/:id не пересчитывает риск внутри
  запроса. Для актуальной оценки используется
  отдельный GET /tasks/:id/risk.
end note

note bottom of UC14
  POST /risk/retrain существует только как
  admin-only заглушка и не запускает реальное
  обучение модели.
end note

@enduml
