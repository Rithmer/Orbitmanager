@startuml
' ============================================================
' Диаграмма 2а. БП2: Изменение статуса задачи
' ============================================================

title Диаграмма активности 2а\nБП2: Изменение статуса задачи

skinparam shadowing false
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #4A5568
  DiamondBackgroundColor #FFF8E1
}
skinparam note {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
}

start

partition "Клиент" #F3F4F6 {
  :Отправить PATCH /tasks/:id\nс Bearer JWT и полем status;
}

partition "Controller + Guards" #E8F5E9 {
  :JwtAuthGuard проверяет access token;
  if (JWT валиден?) then (нет)
    :401 Unauthorized;
    stop
  endif

  :TasksController.update()\nпередает id, dto, userId, accountRole;
}

partition "TasksService" #FFF8E1 {
  :Загрузить task по id;
  if (Задача найдена?) then (нет)
    :404 Not Found;
    stop
  endif

  :Загрузить project по task.projectId;
  if (Проект найден?) then (нет)
    :404 Not Found;
    stop
  endif

  if (accountRole = admin?) then (да)
    :Пропустить проверку членства;
  else (нет)
    :Проверить права:\nowner команды\nили team_lead проекта\nили назначенный developer;
    if (Доступ разрешен?) then (нет)
      :403 Forbidden;
      stop
    endif
  endif

  :Проверить переход статуса\nчерез ALLOWED_TASK_TRANSITIONS;
  note right
    Допустимые переходы:
    new -> in_progress, cancelled
    in_progress -> review, cancelled
    review -> done, in_progress
    cancelled -> new
    done -> финальный
  end note

  if (Переход допустим?) then (нет)
    :422 Unprocessable Entity;
    stop
  endif
}

partition "Prisma + PostgreSQL" #E3F2FD {
  :UPDATE tasks\nSET status, updated_at;
  :INSERT INTO audit_logs\n(action='status_change',\n old_value, new_value,\n entity_type='task');
}

partition "Ответ" #FCE4EC {
  :Вернуть обновленную задачу;
}

partition "Клиент" #F3F4F6 {
  :200 OK + Task;
}

note right
  Риск не пересчитывается внутри PATCH.
  Текущая оценка вызывается отдельно:
  GET /tasks/:id/risk
end note

stop

@enduml
