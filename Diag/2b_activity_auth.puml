@startuml
' ============================================================
' Диаграмма 2б. Регистрация, вход и обновление токена
' ============================================================

title Диаграмма активности 2б\nРегистрация, вход и обновление токена

skinparam shadowing false
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #4A5568
  DiamondBackgroundColor #FFF8E1
}
skinparam note {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
}

start

partition "Клиент" #F3F4F6 {
  :Открыть Swagger\nили planned frontend;
}

note right
  Global ThrottlerGuard включен на уровне приложения.
  Диаграмма ниже показывает бизнес-поток auth,
  без детализации лимитов по каждому endpoint.
end note

if (Сценарий = регистрация?) then (да)

  partition "AuthController" #E8F5E9 {
    :POST /auth/register;
    :ValidationPipe проверяет RegisterDto;
    if (DTO валиден?) then (нет)
      :400 Bad Request;
      stop
    endif
  }

  partition "AuthService + UsersService" #FFF8E1 {
    :Найти пользователя по login;
    if (Логин свободен?) then (нет)
      :409 Conflict;
      stop
    endif

    :Хешировать пароль (argon2);
  }

  partition "Prisma + PostgreSQL" #E3F2FD {
    :INSERT INTO users\n(account_role='member',\n account_status='active');
    :INSERT INTO audit_logs\n(action='create', entity_type='user');
  }

  partition "AuthService" #FFF8E1 {
    :Сгенерировать accessToken\nи refreshToken;
  }

  partition "Клиент" #F3F4F6 {
    :201 Created + TokenPair;
  }

elseif (Сценарий = вход?) then (да)

  partition "AuthController" #E8F5E9 {
    :POST /auth/login;
    :ValidationPipe проверяет LoginDto;
    if (DTO валиден?) then (нет)
      :400 Bad Request;
      stop
    endif
  }

  partition "AuthService" #FFF8E1 {
    :Найти пользователя по login;
    if (Пользователь найден?) then (нет)
      :401 Unauthorized;
      stop
    endif

    :Проверить accountStatus;
    if (Аккаунт заблокирован?) then (да)
      :401 Unauthorized;
      stop
    endif

    :Сравнить пароль через argon2.verify;
    if (Пароль совпадает?) then (нет)
      :401 Unauthorized;
      stop
    endif
  }

  partition "Prisma + PostgreSQL" #E3F2FD {
    :INSERT INTO audit_logs\n(action='login', entity_type='user');
  }

  partition "AuthService" #FFF8E1 {
    :Сгенерировать accessToken\nи refreshToken;
  }

  partition "Клиент" #F3F4F6 {
    :200 OK + TokenPair;
  }

else (refresh)

  partition "AuthController" #E8F5E9 {
    :POST /auth/refresh;
    :ValidationPipe проверяет RefreshDto;
    if (DTO валиден?) then (нет)
      :400 Bad Request;
      stop
    endif
  }

  partition "AuthService" #FFF8E1 {
    :Проверить refreshToken\nчерез JWT_REFRESH_SECRET;
    if (Refresh token валиден?) then (нет)
      :401 Unauthorized;
      stop
    endif

    :Загрузить пользователя по payload.sub;
    if (Пользователь найден?) then (нет)
      :401 Unauthorized;
      stop
    endif

    :Проверить accountStatus;
    if (Аккаунт заблокирован?) then (да)
      :401 Unauthorized;
      stop
    endif

    :Сгенерировать новую пару\naccessToken + refreshToken;
  }

  partition "Клиент" #F3F4F6 {
    :200 OK + TokenPair;
  }

endif

stop

@enduml
